VITE_API_URL=http://localhost:8000

# Ingreso. `local` (default): la API emite el token con `POST /auth/login`.
# `cognito`: los mismos formularios llaman directo a la API del User Pool (`src/lib/auth.ts`).
# Vite hornea estos valores en el build: cambiar uno es rebuild y resubida a S3.
VITE_AUTH_MODE=local
# Solo con VITE_AUTH_MODE=cognito (salen de `terraform output -raw frontend_env`):
VITE_COGNITO_REGION=
VITE_COGNITO_CLIENT_ID=
