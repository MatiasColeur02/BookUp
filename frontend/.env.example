VITE_API_URL=http://localhost:8000

# Ingreso. `local` (default): la API emite el token con `POST /auth/login`.
# `cognito`: Hosted UI de Cognito + el puente HTTPS (`auth-bridge/`); ver COGNITO_ROADMAP.md §6.
# Vite hornea estos valores en el build: cambiar uno es rebuild y resubida a S3.
VITE_AUTH_MODE=local
# Solo con VITE_AUTH_MODE=cognito (salen de los outputs de la infraestructura, §8.3):
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_AUTH_CALLBACK_URL=
VITE_AUTH_SIGNED_OUT_URL=
