DATABASE_URL=postgresql+psycopg2://bookup:bookup@localhost:5432/bookup
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Cache de lecturas. Vacío o sin definir = apagado (la API funciona igual, sin cache).
# En AWS apunta al endpoint de ElastiCache: redis://<primary-endpoint>:6379/0
REDIS_URL=redis://localhost:6379/0

# Rate limiting de los endpoints públicos (login y auto-registro). Usa el mismo Redis
# que el cache: sin REDIS_URL queda apagado. Un límite en 0 apaga ese contador.
RATE_LIMIT_WINDOW_SECONDS=300
RATE_LIMIT_LOGIN_PER_IP=20
RATE_LIMIT_LOGIN_PER_EMAIL=10
RATE_LIMIT_SIGNUP_PER_IP=5

# Techo del cuerpo de un request. Las portadas no cuentan: van directo a S3.
MAX_REQUEST_BYTES=1048576

# Portadas de libros en almacenamiento de objetos. Vacío o sin definir = feature
# apagada (los endpoints de portada dan 503 y el resto de la API anda igual).
# En local apunta al MinIO del compose; en AWS, al bucket S3 real.
S3_BUCKET=bookup-covers
S3_REGION=us-east-1
# Endpoints de MinIO: en AWS los dos se borran y boto3 usa los de S3.
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# CDN delante del bucket (CloudFront). Si está, las portadas se leen por acá.
# S3_PUBLIC_BASE_URL=https://dxxxx.cloudfront.net
# En AWS no se definen: las credenciales salen del rol de la tarea (ECS) o de la
# función (Lambda), que es la cadena default de boto3.
AWS_ACCESS_KEY_ID=bookup
AWS_SECRET_ACCESS_KEY=bookup123

# DynamoDB (migración desde Postgres, ver api/ROADMAP.md). Sin DYNAMO_TABLE no hay tabla
# a la que conectarse. En AWS DYNAMO_ENDPOINT_URL se borra y boto3 usa el endpoint real.
# Desde el host, DynamoDB Local del compose queda en el 8001 (el 8000 es la API).
DYNAMO_TABLE=bookup
DYNAMO_ENDPOINT_URL=http://localhost:8001
AWS_REGION=us-east-1

# Índice de búsqueda del catálogo (OpenSearch). Vacío = apagado. Lo estrena la fase 6.
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=bookup-books
