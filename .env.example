DATABASE_URL=postgresql+psycopg2://bookup:bookup@localhost:5432/bookup
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Cache de lecturas. Vacío o sin definir = apagado (la API funciona igual, sin cache).
# En AWS apunta al endpoint de ElastiCache: redis://<primary-endpoint>:6379/0
REDIS_URL=redis://localhost:6379/0

# Portadas de libros en almacenamiento de objetos. Vacío o sin definir = feature
# apagada (los endpoints de portada dan 503 y el resto de la API anda igual).
# En local apunta al MinIO del compose; en AWS, al bucket S3 real.
S3_BUCKET=bookup-covers
S3_REGION=us-east-1
# Endpoints de MinIO: en AWS los dos se borran y boto3 usa los de S3.
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# CDN delante del bucket (CloudFront). Si está, las portadas se leen por acá.
# S3_PUBLIC_BASE_URL=https://dxxxx.cloudfront.net
# En AWS no se definen: las credenciales salen del rol de la tarea (ECS) o de la
# función (Lambda), que es la cadena default de boto3.
AWS_ACCESS_KEY_ID=bookup
AWS_SECRET_ACCESS_KEY=bookup123
